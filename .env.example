# Every environment variable your app needs, with harmless placeholder values.
# Copy to .env for local use. Real values go into your hosting provider's settings, never into git.
# In a codespace, put the secret ones in the repository's Codespaces secrets instead of a file.

# Server port
PORT=3000

# Database URL (required by startup check)
DATABASE_URL=sqlite:./data/database.sqlite

# Session secret (required by startup check and app session)
SESSION_SECRET=f6871b14cb5a948043799d38904940ec3c569ac53fe4f850c9d5e1fbc4af100d

# Sign in with Google (required by spec)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The model feature API key
GEMINI_API_KEY=

# MCP server token
MCP_TOKEN=
